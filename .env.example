# Mode SaaS (optionnel) : sans ces variables, l'application reste 100 % locale (localStorage)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# IA cloud (optionnelle) — clé conservée côté serveur uniquement, ne JAMAIS préfixer par VITE_
# ANTHROPIC_API_KEY=            # prioritaire si présente
# ANTHROPIC_MODEL=claude-sonnet-5-5
# SCAN_TOKEN=                   # jeton exigé par /api/ai et /api/scan hors localhost
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Démo publique sans base de données (BLC, etc.) : accès libre, données locales au navigateur
# VITE_DEMO_MODE=true
